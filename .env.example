# Docker Compose lee este .env desde la raíz: con COMPOSE_FILE, `docker compose ...`
# funciona desde acá sin -f. El resto son variables de interpolación del compose.
COMPOSE_FILE=deploy/docker/docker-compose.yml

S3_ENDPOINT=http://minio:9000
S3_BUCKET=my-ig-media
S3_BASE_URL=/my-ig-media
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

NOTIF_DB_USER=ig_user
NOTIF_DB_PASS=ig_pass
NOTIF_DB_NAME=ig_notification

# OpenTelemetry: traces al Tempo del stack de observabilidad (feed-platform).
# Vacía = los servicios no exportan (igual generan trace_id para los logs).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_TRACES_SAMPLER_ARG=1.0
